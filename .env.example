# Copy to .env for docker-compose.yml (`copy .env.example .env` on Windows,
# or scripts/setup.ps1 does this for you). Local dev credentials only —
# never used outside your own machine, since docker-compose binds everything
# to 127.0.0.1.
POSTGRES_USER=agentforge
POSTGRES_PASSWORD=agentforge
POSTGRES_DB=agentforge
