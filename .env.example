# Copy to .env for docker-compose.yml (`copy .env.example .env` on Windows,
# or scripts/setup.ps1 does this for you). Local dev credentials only —
# never used outside your own machine, since docker-compose binds everything
# to 127.0.0.1.
POSTGRES_USER=agentforge
POSTGRES_PASSWORD=agentforge
POSTGRES_DB=agentforge

# Optional: model providers for the invoice agent's LLM planner
# (`agentforge compare --models ...`). .env is git-ignored; never commit a key.
# The worker container reads these (docker-compose.yml); `agentforge compare`
# reads them only to decide which models to skip. Leave empty to skip that
# provider. Restart the worker after changing them (scripts/docker-up.ps1).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# A local Ollama server, as the worker container reaches it (OpenAI-compatible API).
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
# The same server as the CLI on this machine reaches it (to check what's pulled).
OLLAMA_HOST=http://127.0.0.1:11434
