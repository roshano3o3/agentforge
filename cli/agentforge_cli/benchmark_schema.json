{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentforge.benchmark/v1",
  "title": "agentforge compare --models: results",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "created_at", "date", "labels", "agentforge", "settings", "datasets", "models",
    "estimate", "actual_spend_usd", "stopped_reason", "not_run", "results"
  ],
  "$defs": {
    "nullableNumber": {"type": ["number", "null"]},
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pass_rate", "tool_selection", "approval_required", "injection_direct", "injection_indirect",
        "unauthorized_tool", "pii_probe", "latency_p50_ms", "latency_p95_ms", "tokens_per_case", "cost_per_case_usd"
      ],
      "properties": {
        "pass_rate": {"$ref": "#/$defs/rate"},
        "tool_selection": {"$ref": "#/$defs/rate"},
        "approval_required": {"$ref": "#/$defs/rate"},
        "injection_direct": {"$ref": "#/$defs/rate"},
        "injection_indirect": {"$ref": "#/$defs/rate"},
        "unauthorized_tool": {"$ref": "#/$defs/rate"},
        "pii_probe": {"$ref": "#/$defs/rate"},
        "latency_p50_ms": {"$ref": "#/$defs/nonNegative"},
        "latency_p95_ms": {"$ref": "#/$defs/nonNegative"},
        "tokens_per_case": {"$ref": "#/$defs/nonNegative"},
        "cost_per_case_usd": {"$ref": "#/$defs/nonNegative"}
      }
    },
    "rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "nonNegative": {"type": ["number", "null"], "minimum": 0},
    "spread": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mean", "min", "max", "n"],
      "properties": {
        "mean": {"$ref": "#/$defs/nullableNumber"},
        "min": {"$ref": "#/$defs/nullableNumber"},
        "max": {"$ref": "#/$defs/nullableNumber"},
        "n": {"type": "integer", "minimum": 0}
      }
    }
  },
  "properties": {
    "schema": {"const": "agentforge.benchmark/v1"},
    "created_at": {"type": "string", "format": "date-time"},
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "labels": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "agentforge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["git_commit", "code_versions", "pricing_sha256"],
      "properties": {
        "git_commit": {"type": ["string", "null"]},
        "code_versions": {"type": "array", "items": {"type": "string"}},
        "pricing_sha256": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repeats", "timeout_seconds", "temperature", "max_cost_usd", "prompt"],
      "properties": {
        "repeats": {"type": "integer", "minimum": 1},
        "timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
        "temperature": {"type": "number", "minimum": 0, "maximum": 2},
        "max_cost_usd": {"type": "number", "minimum": 0},
        "prompt": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "sha256"],
          "properties": {
            "source": {"type": "string"},
            "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
          }
        }
      }
    },
    "datasets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "content_hash", "cases"],
        "properties": {
          "name": {"type": "string"},
          "version": {"type": "integer"},
          "content_hash": {"type": ["string", "null"]},
          "cases": {"type": "integer", "minimum": 0}
        }
      }
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["spec", "provider", "model", "reported_model", "skipped", "datasets", "repeats", "timeout_seconds"],
        "properties": {
          "spec": {"type": "string"},
          "provider": {"enum": ["scripted", "openai", "anthropic", "ollama"]},
          "model": {"type": "string"},
          "reported_model": {"type": ["string", "null"]},
          "skipped": {"type": ["string", "null"]},
          "datasets": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "repeats": {"type": "integer", "minimum": 1},
          "timeout_seconds": {"type": ["number", "null"], "exclusiveMinimum": 0}
        }
      }
    },
    "estimate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assumptions", "per_model", "total_usd"],
      "properties": {
        "assumptions": {"type": "string"},
        "per_model": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["model", "cases", "runs_per_dataset", "usd"],
            "properties": {
              "model": {"type": "string"},
              "cases": {"type": "integer", "minimum": 0},
              "runs_per_dataset": {"type": "integer", "minimum": 1},
              "usd": {"type": "number", "minimum": 0}
            }
          }
        },
        "total_usd": {"type": "number", "minimum": 0}
      }
    },
    "actual_spend_usd": {"type": "number", "minimum": 0},
    "stopped_reason": {"type": ["string", "null"]},
    "not_run": {"type": "array", "items": {"type": "string"}},
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["model", "dataset", "runs", "summary"],
        "properties": {
          "model": {"type": "string"},
          "dataset": {"type": "string"},
          "runs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["run_id", "status", "error_message", "spend_usd", "metrics"],
              "properties": {
                "run_id": {"type": ["string", "null"]},
                "status": {"enum": ["completed", "failed"]},
                "error_message": {"type": ["string", "null"]},
                "spend_usd": {"type": "number", "minimum": 0},
                "metrics": {"$ref": "#/$defs/metrics"}
              }
            }
          },
          "summary": {
            "type": "object",
            "propertyNames": {
              "enum": [
                "pass_rate", "tool_selection", "approval_required", "injection_direct", "injection_indirect",
                "unauthorized_tool", "pii_probe", "latency_p50_ms", "latency_p95_ms", "tokens_per_case",
                "cost_per_case_usd"
              ]
            },
            "required": [
              "pass_rate", "tool_selection", "approval_required", "injection_direct", "injection_indirect",
              "unauthorized_tool", "pii_probe", "latency_p50_ms", "latency_p95_ms", "tokens_per_case",
              "cost_per_case_usd"
            ],
            "additionalProperties": {"$ref": "#/$defs/spread"}
          }
        }
      }
    }
  }
}
